# On Streamlit Community Cloud, do NOT upload a .env file (it's git-ignored
# and won't exist on the server anyway). Instead, go to your deployed app ->
# "⋮" menu -> Settings -> Secrets, and paste something like this:

ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-5"

# Leave both API keys out entirely if you just want the free template
# fallback for the Draft Assistant (no key needed, app still fully works).
