# Copy this file to ".env" and fill in whichever ONE provider you want to use.
# If you leave both blank, the Draft Assistant still works -- it uses a
# transparent template-based fallback built from the closest historical match.

# --- Option A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Option B: OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional tuning ---
# Embedding model used if sentence-transformers is installed
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Hybrid search weighting (keyword vs semantic), used as defaults in the UI
KEYWORD_WEIGHT=0.4
SEMANTIC_WEIGHT=0.6
